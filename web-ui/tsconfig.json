{
    "compilerOptions": {
        "allowJs": false,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "declarationMap": true,
        "skipLibCheck": true,
        "declarationDir": "build/dist/typedefs/",
        "emitDecoratorMetadata": true,
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "resolveJsonModule": true,
        "jsx": "react",
        "lib": [
            "dom",
            "es5",
            "scripthost",
            "es2015",
            "es2015.promise",
            "es2016.array.include",
            "es2018"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": false,
        "noEmitOnError": true,
        "noImplicitAny": false,
        "noImplicitReturns": false,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "outDir": "build/dist/",
        "rootDir": "./src",
        "preserveConstEnums": true,
        "pretty": true,
        "sourceMap": true,
        "strictNullChecks": true,
        "target": "es6",
        "traceResolution": false
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.tsx",
    ],
    "exclude": [
        "src/**/*.test*",
        "node_modules",
        "dist",
        "build"
    ]
}
